# ReforgedZ shop — environment template. Copy to .env and fill in.
# (.env is gitignored — never commit real secrets.)

# Public origin (Steam callback + PayPal return/webhook URLs)
BASE_URL=https://reforgedz.net

# ── PayPal (replaces Stripe) ─────────────────────────────────────────────
# Live app credentials (PayPal Developer dashboard → My Apps & Credentials → Live)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Sandbox app credentials (for admin test-mode purchases)
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_SECRET=
# Webhook IDs are auto-registered on boot and don't need to be set by hand,
# but you can pin them here if you'd rather manage the webhook in the dashboard.
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_WEBHOOK_ID=

# ── Invoice email (mailcow on the EU box) ────────────────────────────────
SMTP_HOST=mail.reforgedz.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=billing@reforgedz.net
SMTP_PASS=
INVOICE_FROM=ReforgedZ Billing <billing@reforgedz.net>

# ── Discord purchase notifications ───────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Game server SSH + Pterodactyl (purchase sync) ────────────────────────
GAME_SERVER_EU_HOST=
GAME_SERVER_NA_HOST=
PTERODACTYL_PANEL_URL=
PTERODACTYL_CLIENT_API_KEY=

# ── Admin API key (server-to-server from the admin page) ─────────────────
SHOP_ADMIN_API_KEY=
