# ReforgedZ shop, environment template. Copy to .env and fill in.
# .env is gitignored and never committed. This file is generated from
# tools/lib/envManifest.js (npm run env:example); edit the manifest, not this.
#
# The doctor (npm run doctor) checks a deployment against the same list.

# ---- Core ------------------------------------------------------------------
# Public origin, no trailing slash. Steam sign-in, PayPal return URLs and the PayPal webhook are all registered against it.
# (required)
BASE_URL=https://reforgedz.net

# Listen port. Default 3000.
PORT=3000

# Where the database, sessions, uploads and backups live. Default: the app directory (the Pterodactyl layout). Docker sets it to the mounted volume.
DATA_DIR=

# Signs login sessions and the console lock cookie. Losing it signs everyone out; a weak or default one makes console accounts forgeable.
# (required, secret)
SESSION_SECRET=

# Comma-separated Steam64 ids that get the admin role, decided on every request.
# (required)
ADMIN_STEAM_IDS=

# Steam Web API key for OpenID sign-in (steamcommunity.com/dev/apikey).
# (required, secret)
STEAM_API_KEY=

# Leave unset. Its only remaining effect is the origin HSTS header, which Cloudflare handles.
NODE_ENV=

# ---- PayPal ----------------------------------------------------------------
# Live app credentials (developer.paypal.com, My Apps & Credentials, Live).
# (required, secret)
PAYPAL_CLIENT_ID=

# (required, secret)
PAYPAL_SECRET=

# Sandbox app credentials, used for admin test-mode purchases only.
# (secret)
PAYPAL_TEST_CLIENT_ID=

# (secret)
PAYPAL_TEST_SECRET=

# Normally left blank: the webhook is found by URL and registered on boot. Set only to pin one managed in the dashboard.
PAYPAL_WEBHOOK_ID=

PAYPAL_TEST_WEBHOOK_ID=

# off stops the daily 08:30 UTC check that compares PayPal Transaction Search with the shop's orders and posts one red card listing payments nothing in the shop accounts for. Blank = on. Nothing is checked without live PayPal credentials either.
RECONCILE=

# ---- Email -----------------------------------------------------------------
# SMTP server for receipts and billing notices. mailcow today; any relay works with the same five variables.
# (required)
SMTP_HOST=mail.reforgedz.net

# Default 587.
SMTP_PORT=587

# true for implicit TLS on 465, false for STARTTLS on 587.
SMTP_SECURE=false

# (required)
SMTP_USER=billing@reforgedz.net

# (required, secret)
SMTP_PASS=

# From header on every email.
INVOICE_FROM=ReforgedZ Billing <billing@reforgedz.net>

# off stops the daily 15:00 UTC email telling a player their priority queue ends in 2 to 3 days and will not renew (a cancelled subscription or a one-time purchase). Blank = on. Nothing is sent without SMTP_HOST either.
EXPIRY_REMINDERS=

# ---- Discord ---------------------------------------------------------------
# Bot token (shared with the ticket bot application) used to grant and remove entitlement roles.
# (required, secret)
DISCORD_BOT_TOKEN=

# The ReforgedZ guild. Defaults to the live guild in code.
DISCORD_GUILD_ID=1352364195211120660

# The "ReforgedZ Payments" webhook into #Payment-Processor. Purchase, refund and subscription cards go through it.
# (required, secret)
DISCORD_WEBHOOK_URL=

# Channel for billing alerts posted as the bot. Defaults to #Payment-Processor in code; point it at a test channel on a non-production copy.
DISCORD_PAYMENT_CHANNEL_ID=

# Role mentioned on the red cards in #Payment-Processor, the ones where someone has to act (a reversed payment, a failed backup, a renewal on a revoked subscription). Blank = red cards post without a mention. Every other card arrives silently or without a mention.
PAYMENTS_ALERT_ROLE_ID=

# Warnings the daily health card lists under "Known, parked" instead of turning amber. A JSON array of {"check": doctor check id, "match": pattern the whole warning text must match, "note": the line staff read}. Blank = nothing parked. A value that cannot be read parks nothing and shows as a warning.
HEALTH_PARKED_WARNINGS=

# Application id of the bot application (Discord developer portal, OAuth2). With the secret below, players link Discord with a Connect button instead of pasting a user id. Add BASE_URL/auth/discord/callback to the application's OAuth2 redirects.
DISCORD_CLIENT_ID=

# OAuth2 client secret of the same application. Unset = the Connect Discord button is hidden and the paste box remains.
# (secret)
DISCORD_CLIENT_SECRET=

# Staff Discord roles and the servers each one covers: comma-separated role ids, each optionally followed by a colon and its servers joined with +, for example 111:*,222:eu1,333:na1+na2. A bare role id covers every server. When the priority queue behind a game.admins entry the shop added lapses, a player holding a role that covers that server stays listed; anyone else is removed. Blank = the ticket bot's staff roles in code: the admin roles cover every server, each Gamemaster role only its own.
STAFF_DISCORD_ROLE_IDS=

# ---- Game servers ----------------------------------------------------------
# base64 of the private key that logs in as GAME_SERVER_EU_USER on GAME_SERVER_EU_HOST. Its public half must be in that user's authorized_keys. NA is reached from the EU host with the EU host's own key.
# (required, secret)
SSH_PRIVATE_KEY_B64=

# SSH entry host. Every server write starts here.
# (required)
GAME_SERVER_EU_HOST=162.19.127.130

# Default 22.
GAME_SERVER_EU_PORT=22

# Default root. Must be able to write the Pterodactyl volumes.
GAME_SERVER_EU_USER=root

# Comma-separated shop paths for EU1,EU2: <volume>/profile/profile/eiry/reforgedz-dotnet-shop. The volume uuids change on a new panel.
# (required)
GAME_SERVER_EU_PATHS=

# Reached by a nested ssh from the EU host as GAME_SERVER_NA_USER.
# (required)
GAME_SERVER_NA_HOST=51.222.254.40

GAME_SERVER_NA_PORT=22

GAME_SERVER_NA_USER=root

# Comma-separated shop paths for NA1,NA2.
# (required)
GAME_SERVER_NA_PATHS=

# Shop path of the NA Dev server (dev1). Optional.
GAME_SERVER_NA_DEV_PATH=

# EU Dev (eu3): reachable for the save inspector, never sold or synced. All four optional.
GAME_SERVER_EU3_HOST=

GAME_SERVER_EU3_PORT=

GAME_SERVER_EU3_USER=

GAME_SERVER_EU3_PATHS=

# Comma-separated SHA256 host-key fingerprints (without the SHA256: prefix) the entry host must present. Unset = accept and log (the doctor warns).
# (recommended)
GAME_SERVER_HOST_FINGERPRINTS=

# 1 to make the nested NA hop refuse unknown host keys instead of recording them on first use.
GAME_SERVER_STRICT_HOSTKEYS=

# Maximum size of game.admins per server. Priority queue stock is ceiling minus the GMs already listed. Default 50.
ADMIN_CEILING=

# ---- Panel -----------------------------------------------------------------
# Panel origin for the homepage status tiles and the restart helper.
# (required)
PTERODACTYL_PANEL_URL=https://panel.reforgedz.net

# A client API key (Account, API Credentials) that can see the game servers.
# (required, secret)
PTERODACTYL_CLIENT_API_KEY=

# BattleMetrics API token: player counts and the console gamertag lookup.
# (required, secret)
BATTLEMETRICS_TOKEN=

# Comma-separated BattleMetrics server ids, numbers only, searched FIRST for a console gamertag until the panel has verified its own records (for example while the panel is unreachable). Trusted as given; records the panel discovers are checked against the organisation instead.
REFORGEDZ_BM_SERVER_IDS=

# BattleMetrics organisation searched when today's servers find nobody, so players whose history sits on an older server record can still sign in. A number; anything else is ignored and the default 112993 (ReforgedZ) is used. Lookups are never unscoped.
REFORGEDZ_BM_ORG_ID=

# ---- Staff -----------------------------------------------------------------
# Shared bearer for /api/shop/admin/* from the admin page and the ticket bot. Must match SHOP_ADMIN_API_KEY in the ticket bot's .env.
# (required, secret)
SHOP_ADMIN_API_KEY=

# Origin used in console re-link links. Defaults to https://reforgedz.net; set it if BASE_URL differs from what players type.
PUBLIC_BASE_URL=

# Tutorial link shown after a Custom Flag purchase. Blank shows a placeholder.
CUSTOM_FLAG_TUTORIAL_URL=

# ---- Backups ---------------------------------------------------------------
# Where the nightly snapshot is copied, comma-separated: na (the NA box over the existing SSH hop), r2 (Cloudflare R2). Blank keeps backups on this box only, which the doctor flags.
BACKUP_OFFSITE=na,r2

# Directory on the NA box for copies. Default /root/reforgedz-shop-backups.
BACKUP_NA_DIR=

# Cloudflare account id (R2 overview page).
R2_ACCOUNT_ID=

# Bucket name, e.g. reforgedz-shop-backups.
R2_BUCKET=

# From R2, Manage R2 API Tokens: a token with Object Read & Write on that bucket only.
# (secret)
R2_ACCESS_KEY_ID=

# (secret)
R2_SECRET_ACCESS_KEY=

# Key prefix inside the bucket. Default shop/.
R2_PREFIX=

# ---- Rehearsal -------------------------------------------------------------
# Set to 1 on a restored copy. The doctor then treats blanked outbound credentials as intended rather than missing. Never set on production.
SHOP_REHEARSAL=

# ---- Retired (delete these from an old .env) ---------------------------------
# STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY, STRIPE_TEST_PUBLISHABLE_KEY, STRIPE_TEST_SECRET_KEY, STRIPE_TEST_WEBHOOK_SECRET, STRIPE_WEBHOOK_SECRET, GAME_SERVER_NA_KEY_PATH
